// one floating island per cell (most cells): its bottom height, half size
vec4 island(vec2 id) {
    float h = hash12(id);
    if (h < 0.22) return vec4(-1.0);
    float y0 = 2.0 + hash12(id + 7.1) * 3.5;
    return vec4(y0, 1.2 + hash12(id + 3.3) * 1.3, 0.3 + hash12(id + 5.7) * 0.45, 1.2 + hash12(id + 9.9) * 1.3);
