// ---------------------------------------------------------------- the road
// The motorway winds and rolls; everything is modelled in "road space": u across the road (0 = the median,
// our side is u < 0, which is screen right), y above the deck, v along it.
float roadX(float z) { return 18.0 * sin(z * 0.011) + 7.0 * sin(z * 0.027 + 1.3); }
float roadY(float z) { return 3.0 * sin(z * 0.006) + 1.2 * sin(z * 0.017 + 0.5); }
vec3 toRoad(vec3 p) { return vec3(p.x - roadX(p.z), p.y - roadY(p.z), p.z); }

float sdBox(vec3 p, vec3 b) { vec3 q = abs(p) - b; return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0); }
float sdRBox(vec3 p, vec3 b, float r) { return sdBox(p, b - r) - r; }

const float GANTRY = 90.0, LAMPS = 30.0, BILLS = 160.0;
float gMat;     // 0 ground/terrain, 1 road deck, 2 barrier/rail, 3 lamp post, 4 lamp head, 5 gantry steel,
                // 6 sign board, 7 billboard, 8 car, 9 truck, 10 our car
float gId;      // which sign / billboard / vehicle
vec3 gLoc;      // local coordinates on that object
float gCarU, gZc;

float hillH(float u, float v) {
    float a = abs(u);
    return smoothstep(4.8, 14.0, a) * (1.2 + 3.5 * noise(vec2(v * 0.013, u * 0.04 + 3.0)) + 1.5 * noise(vec2(v * 0.05, u * 0.1)));
}

float carSDF(vec3 q) {
    float body = sdRBox(q - vec3(0.0, 0.17, 0.0), vec3(0.24, 0.1, 0.58), 0.07);
    float cabin = sdRBox(q - vec3(0.0, 0.34, -0.08), vec3(0.2, 0.09, 0.28), 0.08);
    return min(body, cabin);
}
float truckSDF(vec3 q) {
    float cab = sdRBox(q - vec3(0.0, 0.46, 1.62), vec3(0.32, 0.43, 0.32), 0.06);
    float trailer = sdRBox(q - vec3(0.0, 0.64, -0.38), vec3(0.34, 0.56, 1.62), 0.02);
    return min(cab, trailer);
}

// one lane of traffic, repeated along v; vehicles in our lanes swerve away from our car when we come up behind
float lane(vec3 q, float u0, float dir, float spacing, float speed, float seed, inout float best) {
    // far from this lane (sideways or above the trucks): a cheap lower bound, no vehicle maths
    float lb = max(abs(q.x - u0) - (dir > 0.0 ? 1.35 : 0.42), q.y - 1.3);
    if (lb > best) return lb;
    float shift = dir * uTime * speed;
    float lv = q.z - shift;
    float k = floor(lv / spacing + 0.5);
    float h = hash12(vec2(k, seed));
    if (h < 0.45) return max(spacing * 0.5 - abs(lv - k * spacing), 0.2);
    float vz = k * spacing + shift;                              // where this vehicle is
    float u = u0;
    if (dir > 0.0) {
        float dz = vz - gZc;
        float clash = 1.0 - smoothstep(0.35, 0.85, abs(u0 - gCarU));
        float away = u0 > gCarU ? 1.0 : -1.0;
        u = clamp(u0 + away * 0.9 * clash * smoothstep(14.0, 5.0, dz) * smoothstep(-4.0, -1.0, dz), -3.0, -0.6);
    }
    vec3 lq = vec3(q.x - u, q.y, (q.z - vz) * dir);
    bool truck = fract(h * 7.3) < 0.35;
    float d = truck ? truckSDF(lq) : carSDF(lq);
    if (d < best) { best = d; gMat = truck ? 9.0 : 8.0; gId = h; gLoc = lq; }
    return d;
}

float world(vec3 p) {
    vec3 q = toRoad(p);
    float d = 1e3;
    // deck and verges
    float a = abs(q.x);
    float deck = q.y;
    float terrain = q.y - hillH(q.x, q.z) + smoothstep(4.6, 5.4, a) * 0.25;
    d = a < 4.8 ? deck : terrain * 0.6;
    gMat = a < 4.8 ? 1.0 : 0.0;
    // median barrier and guard rails
    float bar = sdRBox(vec3(q.x, q.y - 0.18, 0.0), vec3(0.12, 0.18, 1e3), 0.04);
    float rail = sdBox(vec3(a - 4.45, q.y - 0.32, 0.0), vec3(0.03, 0.05, 1e3));
    float lv = q.z - floor(q.z / 2.0 + 0.5) * 2.0;
    rail = min(rail, sdBox(vec3(a - 4.47, q.y - 0.17, lv), vec3(0.025, 0.17, 0.025)));
    float b = min(bar, rail);
    if (b < d) { d = b; gMat = 2.0; }
    // lamp posts on the median, an arm over each carriageway
    float kl = floor(q.z / LAMPS + 0.5);
    vec3 lq = vec3(q.x, q.y, q.z - kl * LAMPS);
    float post = max(length(lq.xz) - 0.05, abs(lq.y - 1.8) - 1.8);
    float arm = sdBox(vec3(a - 0.9, lq.y - 3.55, lq.z), vec3(0.9, 0.03, 0.03));
    float pl = min(post, arm);
    if (pl < d) { d = pl; gMat = 3.0; }
    float head = sdRBox(vec3(a - 1.75, lq.y - 3.5, lq.z), vec3(0.22, 0.035, 0.08), 0.02);
    if (head < d) { d = head; gMat = 4.0; }
    // gantries: legs, a truss beam, a big sign over each carriageway
    float kg = floor((q.z - 45.0) / GANTRY + 0.5);
    vec3 gq = vec3(q.x, q.y, q.z - 45.0 - kg * GANTRY);
    float steel = min(sdBox(vec3(a - 4.6, gq.y - 1.7, gq.z), vec3(0.1, 1.7, 0.1)), sdBox(vec3(gq.x, gq.y - 3.3, gq.z + 0.15), vec3(4.7, 0.1, 0.08)));
    if (steel < d) { d = steel; gMat = 5.0; }
    float board = sdBox(vec3(a - 1.8, gq.y - 3.95, gq.z), vec3(1.65, 0.6, 0.05));
    if (board < d) { d = board; gMat = 6.0; gId = kg; gLoc = gq; }
    // billboards up on the hills, on our side, angled toward the traffic
    float kb = floor((q.z - 80.0) / BILLS + 0.5);
    vec3 bq = vec3(q.x + 8.5, q.y, q.z - 80.0 - kb * BILLS);
    bq.xz = rot(0.5) * bq.xz;
    float bpole = max(length(bq.xz) - 0.08, abs(bq.y - 2.5) - 2.6);
    float bboard = sdBox(bq - vec3(0.0, 5.4, 0.0), vec3(2.6, 0.95, 0.08));
    if (bpole < d) { d = bpole; gMat = 5.0; }
    if (bboard < d) { d = bboard; gMat = 7.0; gId = kb; gLoc = bq - vec3(0.0, 5.4, 0.0); }
    // traffic: three lanes our way (we overtake), three oncoming
    float best = d;
    float t0 = lane(q, -0.8, 1.0, 17.0, 5.5, 1.0, best);
    float t1 = lane(q, -1.8, 1.0, 23.0, 4.5, 2.0, best);
    float t2 = lane(q, -2.8, 1.0, 29.0, 3.8, 3.0, best);
    float o0 = lane(q, 0.8, -1.0, 21.0, 9.0, 4.0, best);
    float o1 = lane(q, 1.8, -1.0, 27.0, 8.0, 5.0, best);
    float o2 = lane(q, 2.8, -1.0, 33.0, 7.0, 6.0, best);
    d = min(d, min(min(t0, t1), min(t2, min(o0, min(o1, o2)))));
    // our car
    vec3 cq = vec3(q.x - gCarU, q.y, q.z - gZc);
    float me = carSDF(cq);
    if (me < d) { d = me; gMat = 10.0; gLoc = cq; }
    return d;
}

vec3 worldNormal(vec3 p, float e) {
    vec2 h = vec2(e, -e);
    return normalize(h.xyy * world(p + h.xyy) + h.yyx * world(p + h.yyx) + h.yxy * world(p + h.yxy) + h.xxx * world(p + h.xxx));
}

// ---------------------------------------------------------------- sky and lights
vec3 skyCol(vec3 rd) {
    float dawn = uD;
    vec3 night = mix(vec3(0.03, 0.035, 0.07), vec3(0.003, 0.004, 0.012), smoothstep(0.0, 0.5, rd.y));
    vec3 morn = mix(vec3(1.0, 0.5, 0.26), vec3(0.14, 0.18, 0.4), smoothstep(-0.02, 0.5, rd.y));
    vec3 c = mix(night, morn, dawn * 0.95);
    c += vec3(1.0, 0.6, 0.3) * dawn * exp(-abs(atan(rd.x, rd.z) - 0.3) * 2.5) * exp(-max(rd.y, 0.0) * 6.0) * 0.8;
    // stars, fading with the dawn
    vec2 s = vec2(atan(rd.z, rd.x), asin(clamp(rd.y, -1.0, 1.0))) * 120.0;
    float hs = hash12(floor(s));
    c += vec3(0.9, 0.95, 1.0) * smoothstep(0.995, 1.0, hs) * smoothstep(0.4, 0.0, length(fract(s) - 0.5)) * (1.0 - dawn) * smoothstep(0.02, 0.2, rd.y);
    // the moon
    vec3 md = normalize(vec3(-0.5, 0.35, 0.8));
    float mdd = dot(rd, md);
    c += vec3(0.9, 0.92, 1.0) * (smoothstep(0.9993, 0.9996, mdd) * 1.5 + pow(max(mdd, 0.0), 300.0) * 0.15) * (1.0 - dawn * 0.7);
    // a city on the horizon: tower silhouettes with lit windows and a glow above them
    float az = atan(rd.x, rd.z);
    float bh = 0.012 + 0.03 * pow(noise(vec2(az * 40.0, 1.0)), 3.0) * step(0.3, noise(vec2(az * 3.0, 7.0)));
    bh = floor(bh * 400.0) / 400.0;
    if (rd.y < bh && rd.y > -0.02) {
        vec2 w = vec2(az * 900.0, rd.y * 900.0);
        float lit = step(0.75, hash12(floor(w))) * step(0.2, fract(w.x)) * step(0.3, fract(w.y));
        c = mix(vec3(0.004, 0.005, 0.01), vec3(0.15, 0.2, 0.35) * 0.3, dawn) + vec3(1.0, 0.75, 0.45) * lit * 0.6 * (1.0 - dawn * 0.8);
    }
    c += vec3(1.0, 0.55, 0.25) * exp(-max(rd.y, 0.0) * 30.0) * 0.06 * (1.0 - dawn);
    return c;
}

// glow of the street lamps seen along a ray (for reflections in the wet road): the next few lamp heads
vec3 lampsAlong(vec3 o, vec3 d, float rough, float tMax, float stretch) {
    vec3 acc = vec3(0.0);
    float k0 = floor(o.z / LAMPS + 0.5);
    for (int i = 0; i < 6; i++) {
        float vz = (k0 + float(i)) * LAMPS;
        for (int s = 0; s < 2; s++) {
            vec3 lp = vec3(roadX(vz) + (s == 0 ? -1.75 : 1.75), roadY(vz) + 3.45, vz);
            vec3 w = lp - o;
            float tq = dot(w, d);
            if (tq <= 0.0 || tq > tMax) continue;
            vec3 off = w - d * tq;
            float dist = length(off * vec3(1.0, stretch, 1.0));   // stretch < 1: streaks drawn out vertically (wet road)
            acc += vec3(1.0, 0.68, 0.35) * exp(-dist * dist / (rough * rough * tq * tq + 0.002)) * 0.5;
        }
    }
    return acc;
}

// light pooled on the road from the lamps (both carriageways)
float lampPool(vec3 q) {
    float kl = floor(q.z / LAMPS + 0.5);
    float dz = q.z - kl * LAMPS;
    float du = abs(q.x) - 1.75;
    return 1.0 / (1.0 + (dz * dz * 0.08 + du * du * 0.25 + (3.45 - q.y) * (3.45 - q.y) * 0.05) * 1.0) * 1.0;
}

// ---------------------------------------------------------------- the picture
vec3 scene(vec2 p, vec2 uv) {
    float zc = uShip2.z * 6.0 + 50.0;
    gZc = zc;
    gCarU = -1.8 - uShip2.x * 1.0;                      // strafe right = toward the hard shoulder
    // chase camera: knob C goes from low and close to high and far back
    float back = mix(2.3, 4.5, uC), high = mix(0.85, 2.4, uC);
    float zcam = zc - back;
    vec3 ro = vec3(roadX(zcam) + mix(-1.8, gCarU, 0.8), roadY(zcam) + high, zcam);
    float zt = zc + 7.0;
    vec3 ta = vec3(roadX(zt) + mix(-1.8, gCarU, 0.6), roadY(zt) + 0.3 + uC * 0.2, zt);
    vec3 fw = normalize(ta - ro);
    vec3 rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0))), up = cross(rt, fw);
    vec3 rd = normalize(p.x * rt + p.y * up + 1.5 * fw);

    float t = 0.05;
    bool hit = false;
    for (int i = 0; i < 130; i++) {
        vec3 pos = ro + rd * t;
        float d = world(pos);
        if (d < 0.001 * t) { hit = true; break; }
        t += d * 0.85;
        if (t > 160.0) break;
        if (rd.y > 0.0 && toRoad(pos).y > 12.0) break;
    }
    vec3 col;
    float dawn = uD;
    vec3 hazeC = mix(vec3(0.02, 0.022, 0.04), vec3(0.45, 0.32, 0.3), dawn);
    float px = t * 2.0 / (uRes.y * 1.5);
    if (!hit) {
        col = skyCol(rd);
    } else {
        vec3 pos = ro + rd * t;
        world(pos);
        float mat = gMat, id = gId;
        vec3 loc = gLoc;
        vec3 q = toRoad(pos);
        vec3 n = worldNormal(pos, 0.0007 * t + 0.0005);
        // lighting: lamp pools, our headlights (a cone ahead of the car), moon/dawn ambient
        float pool = lampPool(q);
        vec3 lampC = vec3(1.0, 0.68, 0.35);
        float hz = q.z - gZc - 0.6;
        float hzc = max(hz, 0.0);
        float hl = smoothstep(0.0, 1.0, hz) * exp(-hzc * 0.07) * exp(-pow(q.x - gCarU, 2.0) / (0.08 + hzc * 0.06)) * 2.2;
        vec3 amb = mix(vec3(0.02, 0.025, 0.05), vec3(0.35, 0.3, 0.32), dawn) * (0.5 + 0.5 * n.y);
        vec3 light = amb + lampC * pool * 2.2 * (0.4 + 0.6 * max(n.y, 0.0)) + vec3(0.9, 0.95, 1.0) * hl * max(-n.z * 0.7 + n.y * 0.5, 0.0);
        vec3 alb = vec3(0.1);
        vec3 emit = vec3(0.0);
        if (mat == 0.0) {
            alb = mix(vec3(0.03, 0.04, 0.025), vec3(0.06, 0.07, 0.04), noise(q.xz * 0.7));
            // farm and village lights scattered over the hills: points, never bigger than a couple of pixels' worth
            vec2 g = floor(q.xz * 0.6);
            float rr = max(0.03, px * 0.6 * 1.2);
            float dl = length(fract(q.xz * 0.6) - 0.5 - (hash22(g) - 0.5) * 0.6);
            emit += lampC * step(0.97, hash12(g)) * smoothstep(rr, 0.0, dl) * (0.03 * 0.03) / (rr * rr) * 3.0 * (1.0 - dawn * 0.7);
        } else if (mat == 1.0) {
            // wet asphalt, lane markings, cat's eyes, the light under our car
            float a = abs(q.x);
            alb = vec3(0.05, 0.05, 0.055) * (0.8 + 0.4 * noise(q.xz * 20.0));
            float lineW = max(0.02, px * 0.7);
            float dash = step(0.5, fract(q.z / 3.0));
            float marks = (1.0 - smoothstep(lineW * 0.5, lineW, abs(a - 1.3))) * dash + (1.0 - smoothstep(lineW * 0.5, lineW, abs(a - 2.3))) * dash
                        + (1.0 - smoothstep(lineW * 0.5, lineW, abs(a - 0.35))) + (1.0 - smoothstep(lineW * 0.5, lineW, abs(a - 3.35)));
            alb = mix(alb, vec3(0.75, 0.72, 0.6), clamp(marks, 0.0, 1.0));
            float eye = smoothstep(0.03, 0.0, length(vec2(min(abs(a - 1.3), abs(a - 2.3)), fract(q.z / 3.0 + 0.25) * 3.0 - 1.5))) * (1.0 - smoothstep(0.01, 0.03, px));
            emit += vec3(1.0, 0.9, 0.6) * eye * (0.3 + hl * 3.0);
            vec3 r = reflect(rd, vec3(0.0, 1.0, 0.0));
            float wet = 0.5 + 0.5 * noise(q.xz * 0.8);
            emit += (lampsAlong(pos, r, 0.035 + 0.05 * (1.0 - wet), 200.0, 0.25) + skyCol(r) * 0.15) * wet * 0.6;
            float under = exp(-pow(q.x - gCarU, 2.0) * 12.0 - pow(q.z - gZc, 2.0) * 1.5);
            emit += glowpal(uTime * 0.05) * under * (0.6 + uBeat);
        } else if (mat == 2.0) {
            alb = vec3(0.35, 0.34, 0.32);
        } else if (mat == 3.0 || mat == 5.0) {
            alb = vec3(0.25, 0.26, 0.28);
        } else if (mat == 4.0) {
            emit = lampC * (n.y < -0.5 ? 6.0 : 0.4);
        } else if (mat == 6.0) {
            // the sign: retroreflective green (so it lights up in our headlights), white border and lettering
            vec2 sp = vec2(-(q.x - (q.x < 0.0 ? -1.8 : 1.8)), loc.y - 3.95);   // across (screen right = +), up
            bool front = loc.z < 0.0 && q.x < 0.0;
            alb = vec3(0.25, 0.26, 0.28);
            if (front) {
                int s = int(mod(id, 16.0));
                float n1 = float(textLen(T_SIGN1, s)) * 6.0 - 1.0, n2 = float(textLen(T_SIGN2, s)) * 6.0 - 1.0;
                float fp = min(0.06, 3.0 / max(n1, n2));             // shrink long lines to fit the board
                float fw = px / fp;
                float ink = drawText(T_SIGN1, s, (sp - vec2(-n1 * fp * 0.5, 0.06)) / fp, fw);
                ink = max(ink, drawText(T_SIGN2, s, (sp - vec2(-n2 * fp * 0.5, -0.06 - 7.0 * fp)) / fp, fw));
                float border = smoothstep(0.03, 0.02, abs(max(abs(sp.x) / 1.6, abs(sp.y) / 0.55) - 0.965) * 1.6);
                vec3 green = vec3(0.0, 0.32, 0.14);
                alb = mix(green, vec3(0.95), clamp(ink + border, 0.0, 1.0));
                float retro = 1.0 + 4.0 * smoothstep(60.0, 5.0, t) + hl * 6.0;  // headlights bounce straight back
                light = light * retro;
            }
        } else if (mat == 7.0) {
            // LED billboard: dark panel, a slogan in glowing dots
            vec2 bp = vec2(loc.x, loc.y);
            bool front = loc.z < 0.0;
            alb = vec3(0.04);
            if (front) {
                int s = int(mod(id, 8.0));
                float fp = 0.075;
                float nw = float(textLen(T_BILL, s)) * 6.0 - 1.0;
                float scale = min(1.0, 4.6 / (nw * fp));
                vec2 tq = (bp * vec2(-1.0, 1.0) / scale - vec2(-nw * fp * 0.5, -0.26)) / fp;
                float fw = px / (fp * scale);
                // LED dots: light each font pixel as a round dot
                vec2 dotq = fract(tq) - 0.5;
                float ink = drawText(T_BILL, s, tq, fw) * mix(smoothstep(0.5, 0.3, length(dotq)), 1.0, smoothstep(0.3, 1.0, fw));
                float flick = 0.8 + 0.2 * step(0.5, fract(uTime * 0.7 + id * 0.37));
                emit += glowpal(id * 0.37 + uTime * 0.03) * ink * 2.2 * flick;
                emit += glowpal(id * 0.37) * 0.04;
            }
        } else if (mat == 8.0 || mat == 9.0 || mat == 10.0) {
            // vehicles: glossy paint, tail lights at the back, headlights at the front
            bool mine = mat == 10.0;
            vec3 paint = mine ? vec3(0.02, 0.02, 0.025) : 0.15 + 0.6 * vec3(hash12(vec2(id, 1.0)), hash12(vec2(id, 2.0)), hash12(vec2(id, 3.0)));
            alb = paint;
            float len = mat == 9.0 ? 2.0 : 0.6;
            float rear = smoothstep(-len + 0.04, -len, loc.z);
            float frontE = smoothstep(len - 0.04, len, loc.z + (mat == 9.0 ? 0.0 : 0.0));
            if (mat == 9.0) frontE = smoothstep(1.9, 1.94, loc.z);
            // tail lights: a red bar (ours glows the palette colour too)
            float tl = rear * step(abs(loc.y - (mat == 9.0 ? 0.25 : 0.2)), 0.035) * step(0.12, abs(loc.x));
            emit += (mine ? mix(vec3(1.0, 0.05, 0.08), glowpal(0.0), 0.3) : vec3(1.0, 0.04, 0.03)) * tl * 3.0;
            emit += vec3(1.0, 0.95, 0.85) * frontE * step(abs(loc.y - 0.2), 0.04) * step(0.12, abs(loc.x)) * 5.0;
            if (mat == 9.0) {
                // the trailer: glowsticks stacked along its sides, and a message on the back doors
                float side = step(0.3, abs(n.x)) * step(loc.z, 1.2);
                float stick = smoothstep(0.03, 0.0, abs(fract((loc.z + loc.y * 0.6) * 2.5) - 0.5) - 0.18) * step(0.15, loc.y) * step(loc.y, 1.12);
                emit += glowpal(floor((loc.z + loc.y * 0.6) * 2.5) * 0.17 + id) * stick * side * 1.2;
                if (rear > 0.5) {
                    int s = int(mod(id * 13.0, 3.0));
                    float fp = 0.032;
                    float nw = float(textLen(T_TRUCK, s)) * 6.0 - 1.0;
                    float sc = min(1.0, 0.6 / (nw * fp));
                    float ink = drawText(T_TRUCK, s, (vec2(-loc.x, loc.y - 0.75) / sc - vec2(-nw * fp * 0.5, 0.0)) / fp, px / (fp * sc));
                    alb = mix(vec3(0.75, 0.76, 0.78), vec3(0.05), ink);
                }
            }
            // clear coat: a mirror of the lamps and sky
            vec3 r = reflect(rd, n);
            float fres = 0.04 + 0.96 * pow(1.0 - max(dot(n, -rd), 0.0), 5.0);
            emit += (lampsAlong(pos, r, 0.02, 200.0, 1.0) + skyCol(r) * 0.4) * fres * (mine ? 1.5 : 1.0);
        }
        col = alb * light + emit;
        float fog = 1.0 - exp(-t * mix(0.012, 0.02, dawn));
        col = mix(col, hazeC + vec3(1.0, 0.6, 0.3) * 0.02, fog);
    }
    // glow around the lamp heads in the haze
    col += lampsAlong(ro, rd, 0.012, hit ? t : 1e3, 1.0) * 0.25;

    // HUD: a speedometer in BPM, and the distance to the afters (it never gets any closer)
    vec2 fc = uv * uRes;
    float sc = max(1.0, floor(uRes.y / 260.0));
    float bpm = floor(118.0 + uShip2.w * 56.0 + uBass * 6.0);
    vec2 hq = (fc - vec2(uRes.x - sc * 60.0, sc * 8.0)) / sc;
    float hud = drawNum(bpm, 3, hq / 1.6, 1.0 / (sc * 1.6));
    hud = max(hud, drawText(T_HUD, 0, hq - vec2(31.0, 0.0), 1.0 / sc));
    vec2 kq = (fc - vec2(sc * 8.0, sc * 8.0)) / sc;
    hud = max(hud, drawNum(floor(3.0 + 3.0 * fract(zc * 0.0007)), 1, kq, 1.0 / sc));
    hud = max(hud, drawText(T_HUD, 1, kq - vec2(10.0, 0.0), 1.0 / sc));
    col = mix(col, glowpal(0.1) * 1.6 + 0.3, hud * 0.9);
    return col;
}
