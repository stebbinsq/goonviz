# systemd unit: starts Prism on boot, straight onto the HDMI/projector output.
# Installed by setup_pi.sh (which fills in USER and DIR).
[Unit]
Description=GoonViz visual synth
After=sound.target network.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python __DIR__/run.py
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
