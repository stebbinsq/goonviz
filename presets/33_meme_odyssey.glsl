    vec4(0.82, 0.18, 0.82, 1.42), vec4(0.18, 1.42, 0.18, 0.18), vec4(0.18, 0.18, 0.50, 0.62), vec4(0.50, 0.62, 0.82, 0.18),
    vec4(0.82, 0.18, 0.82, 1.42), vec4(0.18, 1.42, 0.82, 1.42), vec4(0.82, 1.42, 0.82, 0.18), vec4(0.82, 0.18, 0.18, 0.18),
    vec4(0.38, 0.82, 0.82, 0.82), vec4(0.82, 1.42, 0.18, 1.42), vec4(0.18, 1.42, 0.18, 0.18), vec4(0.18, 0.18, 0.82, 0.18),
    vec4(0.82, 0.18, 0.82, 0.82), vec4(0.82, 0.82, 0.18, 0.82), vec4(0.18, 0.18, 0.18, 1.42), vec4(0.18, 1.42, 0.82, 1.42),
    vec4(0.82, 1.42, 0.82, 0.18), vec4(0.82, 0.18, 0.18, 0.18), vec4(0.18, 0.18, 0.82, 1.42)
