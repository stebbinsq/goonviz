        if (hash12(id + 2.2) > 0.5) {
            vec3 tq = vec3(lc.x - is.y * 0.4, p.y - (y0 + hy * 2.0), lc.y + is.w * 0.3);
            float trunk = max(length(tq.xz) - 0.16, abs(tq.y - 0.7) - 0.7);
            float canopy = length(tq - vec3(0.0, 1.9, 0.0)) - 0.85;
            if (trunk < d) { d = trunk; gMat = 1.0; }
            if (canopy < d) { d = canopy; gMat = 2.0; }
        }
        // a spinning coin
        if (hash12(id + 8.8) > 0.4) {
            vec3 cq = vec3(lc.x + is.y * 0.3, p.y - (y0 + hy * 2.0 + 0.8 + 0.15 * sin(uTime * 2.0 + id.x)), lc.y - is.w * 0.2);
