// @preset {"energy": 2, "family": "tunnel", "heavy": true, "name": "Glowstick Shooter", "labels": {"a": "lasers", "b": "look around", "c": "pixels", "d": "crowd"}, "params": {"palette": 5, "glow": 0.4, "feedback": 0.0, "chroma": 0.0, "a": 0.6, "b": 0.2, "c": 0.5, "d": 0.6}}
// A 90s corridor shooter through an endless warehouse rave, in chunky pixels. Brick corridors with rave
// posters, strip lights, crates; doorways into dance rooms full of lasers and a crowd of silhouettes waving
// glowsticks. Your weapon is a glowstick (it lights the walls in its colour, and flares on every beat); every
// 32 beats, or on a drop, you switch: water bottle, hand fan, lighter, phone at 2%. The status bar tracks
// HYDRATION, BRAINCELLS and VIBES, and the face in the middle gurns with the bass. You walk on the music's
// pulse. A = lasers, B = look around, C = pixel size, D = crowd density.
// @text {"POSTER": ["PLUR", "HYDRATE", "NO PHOTOS", "CHILL ROOM", "TOILETS →", "LOST & FOUND", "BASS", "GOONVIZ"], "HUD": ["HYDRATION", "BRAINCELLS", "VIBES", "%"], "WEAPON": ["GLOWSTICK", "WATER BOTTLE", "HAND FAN", "LIGHTER", "PHONE (2%)"]}

// <text>  generated by tools/glsl_text.py from the @text line above: edit that line and rerun the tool
const ivec2 FONT[39] = ivec2[39](ivec2(708142, 14905), ivec2(135556, 14468), ivec2(67118, 32004), ivec2(69727, 14881), ivec2(600258, 2143), ivec2(64031, 14881), ivec2(999686, 14897), ivec2(133183, 8456), ivec2(476718, 14897), ivec2(509486, 12353), ivec2(1001022, 16912), ivec2(541200, 32272), ivec2(575025, 14897), ivec2(1001022, 18004), ivec2(1033777, 17969), ivec2(345649, 4228), ivec2(575068, 29265), ivec2(575022, 17983), ivec2(135327, 4228), ivec2(999967, 32272), ivec2(714289, 17971), ivec2(575022, 14897), ivec2(0, 0), ivec2(475663, 30753), ivec2(541230, 14896), ivec2(135310, 14468), ivec2(710513, 17969), ivec2(1017984, 130), ivec2(283212, 13909), ivec2(999967, 16912), ivec2(1001022, 31281), ivec2(770606, 15921), ivec2(575025, 4433), ivec2(133183, 32264), ivec2(133944, 3688), ivec2(706097, 10933), ivec2(807505, 18004), ivec2(270466, 2184), ivec2(67720, 8322));  // 0123456789PLURHYDATENO SCIM→&FBGVZ%WK()
const int T_POSTER = 0;
const int POSTER_OFF[9] = int[9](0, 4, 11, 20, 30, 39, 51, 55, 62);
const int POSTER_CH[62] = int[62](10, 11, 12, 13, 14, 15, 16, 13, 17, 18, 19, 20, 21, 22, 10, 14, 21, 18, 21, 23, 24, 14, 25, 11, 11, 22, 13, 21, 21, 26, 18, 21, 25, 11, 19, 18, 23, 22, 27, 11, 21, 23, 18, 22, 28, 22, 29, 21, 12, 20, 16, 30, 17, 23, 23, 31, 21, 21, 20, 32, 25, 33);
//   POSTER 0: PLUR
//   POSTER 1: HYDRATE
//   POSTER 2: NO PHOTOS
//   POSTER 3: CHILL ROOM
//   POSTER 4: TOILETS →
//   POSTER 5: LOST & FOUND
//   POSTER 6: BASS
//   POSTER 7: GOONVIZ
const int T_HUD = 1;
const int HUD_OFF[5] = int[5](0, 9, 19, 24, 25);
const int HUD_CH[25] = int[25](14, 15, 16, 13, 17, 18, 25, 21, 20, 30, 13, 17, 25, 20, 24, 19, 11, 11, 23, 32, 25, 30, 19, 23, 34);
//   HUD 0: HYDRATION
//   HUD 1: BRAINCELLS
//   HUD 2: VIBES
//   HUD 3: %
const int T_WEAPON = 2;
const int WEAPON_OFF[6] = int[6](0, 9, 21, 29, 36, 46);
const int WEAPON_CH[46] = int[46](31, 11, 21, 35, 23, 18, 25, 24, 36, 35, 17, 18, 19, 13, 22, 30, 21, 18, 18, 11, 19, 14, 17, 20, 16, 22, 29, 17, 20, 11, 25, 31, 14, 18, 19, 13, 10, 14, 21, 20, 19, 22, 37, 2, 34, 38);
//   WEAPON 0: GLOWSTICK
//   WEAPON 1: WATER BOTTLE
//   WEAPON 2: HAND FAN
//   WEAPON 3: LIGHTER
//   WEAPON 4: PHONE (2%)
int textLen(int grp, int s) {
    if (grp == 0) return POSTER_OFF[s + 1] - POSTER_OFF[s];
    if (grp == 1) return HUD_OFF[s + 1] - HUD_OFF[s];
    if (grp == 2) return WEAPON_OFF[s + 1] - WEAPON_OFF[s];
    return 0;
}
int textChar(int grp, int s, int i) {
    if (grp == 0) return POSTER_CH[POSTER_OFF[s] + i];
    if (grp == 1) return HUD_CH[HUD_OFF[s] + i];
    if (grp == 2) return WEAPON_CH[WEAPON_OFF[s] + i];
    return 10;
}
float glyphBit(int g, ivec2 c) {
    if (c.x < 0 || c.x > 4 || c.y < 0 || c.y > 6) return 0.0;
    int row = 6 - c.y;
    ivec2 f = FONT[g];
    int bits = row < 4 ? (f.x >> (row * 5)) : (f.y >> ((row - 4) * 5));
    return float((bits >> (4 - c.x)) & 1);
}
// 4-tap rotated-grid coverage of the glyph pixels; text smaller than about a screen pixel per font pixel
// fades to its average grey instead of shimmering
float drawText(int grp, int s, vec2 q, float fw) {
    int n = textLen(grp, s);
    if (q.x < -1.0 || q.y < -1.0 || q.y > 8.0 || q.x > float(n) * 6.0) return 0.0;
    float cov = 0.0;
    for (int k = 0; k < 4; k++) {
        vec2 o = (k == 0 ? vec2(0.125, 0.375) : k == 1 ? vec2(0.375, -0.125) : k == 2 ? vec2(-0.125, -0.375) : vec2(-0.375, 0.125)) * min(fw, 1.5);
        vec2 qq = q + o;
        int i = int(floor(qq.x / 6.0));
        if (i < 0 || i >= n) continue;
        cov += glyphBit(textChar(grp, s, i), ivec2(floor(qq.x - float(i) * 6.0), floor(qq.y)));
    }
    float box = step(0.0, q.x) * step(q.x, float(n) * 6.0 - 1.0) * step(0.0, q.y) * step(q.y, 7.0);
    return mix(cov * 0.25, box * 0.3, smoothstep(1.0, 2.5, fw));
}
float drawNum(float v, int digits, vec2 q, float fw) {
    if (q.x < -1.0 || q.y < -1.0 || q.y > 8.0 || q.x > float(digits) * 6.0) return 0.0;
    float cov = 0.0;
    for (int k = 0; k < 4; k++) {
        vec2 o = (k == 0 ? vec2(0.125, 0.375) : k == 1 ? vec2(0.375, -0.125) : k == 2 ? vec2(-0.125, -0.375) : vec2(-0.375, 0.125)) * min(fw, 1.5);
        vec2 qq = q + o;
        int i = int(floor(qq.x / 6.0));
        if (i < 0 || i >= digits) continue;
        int d = int(mod(floor(max(v, 0.0) / pow(10.0, float(digits - 1 - i))), 10.0));
        cov += glyphBit(d, ivec2(floor(qq.x - float(i) * 6.0), floor(qq.y)));
    }
    float box = step(0.0, q.x) * step(q.x, float(digits) * 6.0 - 1.0) * step(0.0, q.y) * step(q.y, 7.0);
    return mix(cov * 0.25, box * 0.3, smoothstep(1.0, 2.5, fw));
}
// </text>
float pathX(float z) { return 6.0 * sin(z * 0.045) + 2.5 * sin(z * 0.11 + 1.0); }
const float W = 2.2, H = 3.2, DOOR = 24.0;
float sdBox(vec3 p, vec3 b) { vec3 q = abs(p) - b; return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0); }

float gMat;   // 0 wall, 1 floor, 2 ceiling, 3 crate, 4 light fixture, 5 room wall
// empty space = corridor + a doorway and a dance room every DOOR units (alternating sides); solid = the rest
float world(vec3 p) {
    vec3 q = vec3(p.x - pathX(p.z), p.y, p.z);
    float kd = floor(q.z / DOOR + 0.5);
    float s = mod(kd, 2.0) < 0.5 ? 1.0 : -1.0;
    float dz = q.z - kd * DOOR;
    float su = s * q.x;
    float eCorr = min(W - abs(q.x), min(q.y, H - q.y));
    float eDoor = min(min(1.1 - abs(dz), 2.5 - q.y), min(q.y, 0.6 - abs(su - (W + 0.3))));
    float eRoom = min(min(4.6 - abs(su - (W + 0.6 + 4.6)), 6.0 - abs(dz)), min(q.y, 4.2 - q.y));
    float e = max(eCorr, max(eDoor, eRoom));
    float d = e;                                              // distance to the nearest wall, from inside the space
    gMat = eRoom > eCorr && su > W ? 5.0 : (q.y < 0.02 ? 1.0 : (q.y > H - 0.02 && eRoom < 0.0 ? 2.0 : 0.0));
    if (q.y < 0.05) gMat = 1.0;
    // crates stacked against the walls
    float kc = floor(q.z / 9.0 + 0.5);
    float hc = hash12(vec2(kc, 3.0));
    if (hc > 0.35) {
        float side = hc > 0.67 ? 1.0 : -1.0;
        float ht = hc > 0.85 ? 1.3 : 0.62;
        float c = sdBox(vec3(q.x - side * (W - 0.45), q.y - ht * 0.5, q.z - kc * 9.0 - 1.5), vec3(0.4, ht * 0.5, 0.42));
        if (c < d) { d = c; gMat = 3.0; }
    }
    // strip lights on the ceiling
    float kl = floor(q.z / 4.0 + 0.5);
    float lf = sdBox(vec3(q.x, q.y - (H - 0.06), q.z - kl * 4.0), vec3(0.08, 0.05, 0.7));
    if (lf < d) { d = lf; gMat = 4.0; }
    return d;
}

// ---------------------------------------------------------------- the crowd: billboard sprites
// silhouette of a raver with both arms up, glowsticks in hand; returns (body mask, glowstick mask)
vec2 raver(vec2 l, float ph, float id) {
    float bob = uBeat * 0.06 + 0.03 * sin(ph);
    l.y -= bob;
    float sway = 0.05 * sin(ph * 0.5 + id * 6.0);
    float head = length(l - vec2(sway, 1.63)) - 0.13;
    float torso = max(abs(l.x - sway * 0.5) - 0.17, abs(l.y - 1.2) - 0.3);
    float legs = max(abs(abs(l.x) - 0.1) - 0.06, abs(l.y - 0.45) - 0.45);
    float body = min(head, min(torso, legs));
    float stick = 1e3;
    for (int k = 0; k < 2; k++) {
        float sg = k == 0 ? -1.0 : 1.0;
        vec2 sh = vec2(sg * 0.17 + sway * 0.5, 1.43);
        vec2 hand = vec2(sg * (0.32 + 0.08 * sin(ph + sg)), 1.86 + 0.06 * sin(ph * 2.0 + sg));
        vec2 pa = l - sh, ba = hand - sh;
        float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
        body = min(body, length(pa - ba * h) - 0.045);
        vec2 tip = hand + vec2(sg * 0.12, 0.22);
        pa = l - hand; ba = tip - hand;
        h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
        stick = min(stick, length(pa - ba * h) - 0.03);
    }
    return vec2(step(body, 0.0), step(stick, 0.0) + exp(-max(stick, 0.0) * 30.0) * 0.4);
}

vec3 scene(vec2 pIn, vec2 uv) {
    // chunky pixels: render on a virtual low-res grid (C sets how chunky)
    float vres = mix(240.0, 140.0, uC);
    float ps = max(1.0, floor(uRes.y / vres));
    vec2 fc = (floor(uv * uRes / ps) + 0.5) * ps;
    vec2 p = (fc / uRes * 2.0 - 1.0) * vec2(uRes.x / uRes.y, 1.0);
    vec2 vp = floor(uv * uRes / ps);                          // virtual pixel coordinates (for the HUD)
    vec2 vsize = floor(uRes / ps);

    // walking: along the corridor on the pulse clock, with a head bob
    float z = uPulse * 1.5;
    float bobPh = z * 3.2;
    vec3 ro = vec3(pathX(z), 1.55 + 0.035 * abs(sin(bobPh)), z);
    float z2 = z + 2.0;
    vec3 fwd = normalize(vec3(pathX(z2) - pathX(z), 0.0, 2.0));
    float yaw = sin(uTime * 0.13) * uB * 0.9;
    fwd.xz = rot(yaw) * fwd.xz;
    vec3 fw = normalize(fwd + vec3(0.0, -0.03, 0.0));
    vec3 rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0))), up = cross(rt, fw);
    vec3 rd = normalize(p.x * rt + p.y * up + 1.3 * fw);

    float t = 0.02;
    bool hit = false;
    for (int i = 0; i < 110; i++) {
        float d = world(ro + rd * t);
        if (d < 0.002) { hit = true; break; }
        t += d;
        if (t > 60.0) break;
    }
    vec3 col = vec3(0.0);
    vec3 pos = ro + rd * t;
    world(pos);
    float mat = gMat;
    vec3 q = vec3(pos.x - pathX(pos.z), pos.y, pos.z);
    float kd = floor(q.z / DOOR + 0.5);
    vec3 roomC = glowpal(kd * 0.37 + uTime * 0.05);
    // the player's own glowstick: a light that travels with you
    float wpn = mod(floor(uBeatCount / 32.0) + uMusic.w, 5.0);
    vec3 stickC = glowpal(0.3 + wpn * 0.2);
    float stickPow = wpn < 0.5 ? 1.0 : (wpn > 2.5 && wpn < 3.5 ? 0.6 : 0.25);   // glowstick bright, lighter warm, others dim
    if (wpn > 2.5 && wpn < 3.5) stickC = vec3(1.0, 0.6, 0.25);
    if (hit) {
        // pixel-art textures: 16 texels per unit
        vec2 tc;
        float axisU = abs(abs(q.x) - W) < 0.02 ? 1.0 : 0.0;
        tc = mat == 1.0 || mat == 2.0 ? q.xz : vec2(q.z, q.y);
        if (mat == 3.0) tc = vec2(q.z + q.x, q.y);
        if (mat == 5.0) tc = vec2(q.z + q.x, q.y);
        vec2 tx = floor(tc * 16.0);
        float n1 = hash12(tx);
        vec3 alb;
        if (mat == 0.0) {
            // bricks with mortar, and a poster every few metres
            vec2 b = tc * vec2(4.0, 8.0);
            b.x += mod(floor(b.y), 2.0) * 0.5;
            vec2 bf = fract(b);
            float mortar = step(bf.x, 0.08) + step(bf.y, 0.14);
            alb = mix(vec3(0.33, 0.16, 0.12) * (0.75 + 0.5 * hash12(floor(b))), vec3(0.22, 0.21, 0.2), clamp(mortar, 0.0, 1.0));
            alb *= 0.85 + 0.3 * n1;
            float kp = floor(q.z / 6.0 + 0.5);
            vec2 pl = vec2(q.z - kp * 6.0, q.y - 1.65);
            if (abs(pl.x) < 0.55 && abs(pl.y) < 0.45 && hash12(vec2(kp, sign(q.x))) > 0.3) {
                int ps2 = int(mod(kp * 3.0 + (q.x > 0.0 ? 1.0 : 0.0), 8.0));
                vec3 pc = glowpal(kp * 0.29);
                float n = float(textLen(T_POSTER, ps2)) * 6.0 - 1.0;
                float fp = min(0.06, 1.0 / n);
                float side = q.x > 0.0 ? 1.0 : -1.0;          // read left to right from inside the corridor
                vec2 tq = (vec2(pl.x * side, pl.y) + vec2(n * fp * 0.5, 3.5 * fp)) / fp;
                float ink = drawText(T_POSTER, ps2, floor(tq) + 0.5, 0.5);
                alb = mix(pc * 0.8, vec3(0.05), ink);
                alb *= 0.9 + 0.2 * step(0.5, hash12(floor(pl * 20.0)));
            }
        } else if (mat == 1.0) {
            vec2 tf = fract(tc * 0.5);
            alb = vec3(0.2, 0.2, 0.21) * (0.8 + 0.3 * n1) * (1.0 - 0.4 * (step(tf.x, 0.03) + step(tf.y, 0.03)));
        } else if (mat == 2.0) {
            alb = vec3(0.08, 0.08, 0.09) * (0.8 + 0.3 * n1);
        } else if (mat == 3.0) {
            vec2 pk = fract(tc * vec2(1.0, 4.0));
            alb = vec3(0.45, 0.3, 0.15) * (0.75 + 0.4 * n1) * (1.0 - 0.5 * step(pk.y, 0.1));
        } else if (mat == 4.0) {
            alb = vec3(0.0);
            col += vec3(0.8, 0.9, 1.0) * 2.5 * (0.85 + 0.15 * step(0.08, hash12(vec2(floor(q.z / 4.0 + 0.5), floor(uRealTime * 12.0)))));
        } else {
            alb = vec3(0.07, 0.06, 0.08) * (0.8 + 0.4 * n1);
        }
        // light: ceiling strips, the glowstick in your hand, the dance rooms spilling out of their doors
        vec3 lightL = vec3(0.0);
        float lz = q.z - floor(q.z / 4.0 + 0.5) * 4.0;
        lightL += vec3(0.6, 0.65, 0.75) * 0.9 / (1.0 + lz * lz * 0.6 + pow(H - q.y, 2.0) * 0.2 + q.x * q.x * 0.1) * step(mat, 4.5);
        vec3 sp = ro + rt * 0.35 - up * 0.3 + fw * 0.5;
        float sd = length(pos - sp);
        lightL += stickC * stickPow * (1.2 + uBeat * 1.5) / (1.0 + sd * sd * 0.9);
        float dz = q.z - kd * DOOR;
        float s = mod(kd, 2.0) < 0.5 ? 1.0 : -1.0;
        float inRoom = step(W + 0.2, s * q.x);
        float spill = (inRoom > 0.5 ? 1.0 : exp(-dz * dz * 0.25) * smoothstep(0.0, W, s * q.x + W * 0.3));
        float strobe = step(0.7, uBeat) * 2.0;
        lightL += roomC * spill * (0.4 + uBeat * 1.2 + strobe) * (inRoom > 0.5 ? 1.0 : 0.7);
        col += alb * lightL;
        // lasers splashing across the room walls
        if (inRoom > 0.5) {
            vec2 lw = vec2(dz, q.y);
            float beams = 0.0;
            for (int i = 0; i < 4; i++) {
                float a = uTime * (0.4 + 0.1 * float(i)) + float(i) * 1.7;
                beams += smoothstep(0.06, 0.0, abs(dot(lw - vec2(0.0, 3.5), vec2(cos(a), sin(a)))));
            }
            col += glowpal(kd * 0.37 + 0.5) * beams * uA * 1.5 * (0.5 + uBeat);
        }
    }
    // laser beams through the haze, crossing the dance rooms we can see into
    {
        vec3 dc = vec3(pathX(kd * DOOR) + (mod(kd, 2.0) < 0.5 ? 1.0 : -1.0) * (W + 5.2), 3.9, kd * DOOR);
        for (int i = 0; i < 5; i++) {
            float a = uTime * (0.5 + 0.13 * float(i)) + float(i) * 1.3;
            vec3 dir = normalize(vec3(cos(a) * 0.8, -0.55, sin(a)));
            vec3 w0 = ro - dc;
            float bb = dot(rd, dir), dd = dot(rd, w0), ee = dot(dir, w0);
            float den = max(1.0 - bb * bb, 1e-4);
            float sc = (bb * ee - dd) / den;
            float tc = max((ee - bb * dd) / den, 0.0);
            float dist = length(w0 + rd * sc - dir * tc);
            col += glowpal(float(i) * 0.2 + kd * 0.37) * exp(-dist * dist / 0.0012) * step(0.0, sc) * step(sc, t) * uA * 0.9 * exp(-tc * 0.1);
        }
    }
    // the crowd: sprites along the corridor and in the nearest dance rooms (billboards facing us)
    {
        vec3 fh = normalize(vec3(fw.x, 0.0, fw.z));
        vec3 rh = vec3(fh.z, 0.0, -fh.x);
        float bestT = t;
        vec3 sprCol = vec3(0.0);
        float sprA = 0.0;
        float k0 = floor(z / 5.5);
        for (int i = 0; i < 14; i++) {
            float k = k0 + float(i % 7) + 1.0;
            vec3 P;
            float id, present;
            if (i < 7) {
                id = k;
                float side = mod(k, 2.0) < 0.5 ? 1.0 : -1.0;
                P = vec3(pathX(k * 5.5) + side * 1.3, 0.0, k * 5.5 + 1.0);
                present = step(hash12(vec2(k, 9.0)), 0.25 + 0.6 * uD);
            } else {
                // dance room crowd: a block of ravers inside the next room
                float kr = floor(z / DOOR + 0.5) + floor(float(i - 7) / 4.0) + (z - floor(z / DOOR + 0.5) * DOOR > 0.0 ? 1.0 : 0.0);
                float s = mod(kr, 2.0) < 0.5 ? 1.0 : -1.0;
                float j = mod(float(i - 7), 4.0);
                id = kr * 7.0 + j;
                P = vec3(pathX(kr * DOOR) + s * (W + 2.2 + mod(j, 2.0) * 1.6), 0.0, kr * DOOR - 1.6 + floor(j / 2.0) * 2.2 + hash12(vec2(id, 2.0)) * 0.6);
                present = step(hash12(vec2(id, 5.0)), 0.4 + 0.6 * uD);
            }
            if (present < 0.5) continue;
            float den = dot(rd, fh);
            if (den <= 0.01) continue;
            float ts = dot(P - ro, fh) / den;
            if (ts <= 0.2 || ts >= bestT) continue;
            vec3 hp = ro + rd * ts;
            vec2 l = vec2(dot(hp - P, rh), hp.y);
            if (abs(l.x) > 0.7 || l.y > 2.3) continue;
            vec2 m = raver(l, uTime * 4.0 + id * 2.3, id);
            if (m.x > 0.5) {
                bestT = ts;
                // dark silhouette, rim-lit by the room light behind
                sprCol = vec3(0.02, 0.02, 0.03) + roomC * 0.08;
                sprA = 1.0;
            }
            sprCol += glowpal(id * 0.31) * m.y * (1.2 + uBeat) * (1.0 - sprA * step(m.y, 0.9));
        }
        col = mix(col, sprCol, sprA);
        if (sprA < 0.5) col += sprCol;
    }
    // darkness swallowing the distance, 90s style
    col *= exp(-t * 0.045);

    // ---- the weapon, bottom right, in virtual pixels
    vec2 wo = vec2(vsize.x * 0.72, 18.0 + 4.0 * abs(sin(bobPh)) + uBeat * 6.0);
    float swapPh = mod(uBeatCount, 32.0);
    wo.y -= (1.0 - smoothstep(0.0, 2.0, swapPh)) * 40.0;            // lowered and raised on a swap
    vec2 w = vp - wo;
    vec3 wcol = vec3(0.0);
    float wa = 0.0;
    // the hand: a gloved fist
    vec2 hq = w - vec2(10.0, 22.0);
    float fist = length(hq * vec2(1.0, 1.25)) - 13.0;
    float arm = max(abs(w.x - 22.0 + w.y * 0.35) - 9.0, w.y - 18.0);
    if (min(fist, arm) < 0.0) { wcol = vec3(0.12, 0.1, 0.14) * (1.0 + 0.4 * step(fist, -10.0)); wa = 1.0; }
    if (abs(min(fist, arm)) < 1.0) { wcol = vec3(0.03); wa = 1.0; }
    if (wpn < 0.5) {
        // glowstick
        vec2 a = vec2(4.0, 30.0), b = vec2(-14.0, 70.0);
        vec2 pa = w - a, ba = b - a;
        float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
        float d = length(pa - ba * h) - 4.0;
        if (d < 0.0) { wcol = mix(stickC * 1.6, vec3(1.0), 0.3 * step(d, -2.5)); wa = 1.0; }
        else col += stickC * exp(-d * (0.12 - uBeat * 0.06)) * 0.6;
    } else if (wpn < 1.5) {
        // water bottle
        vec2 bq = w - vec2(0.0, 52.0);
        float bottle = max(abs(bq.x) - 9.0, abs(bq.y) - 22.0);
        float cap = max(abs(bq.x) - 4.0, abs(bq.y - 26.0) - 4.0);
        if (bottle < 0.0) { wcol = mix(vec3(0.5, 0.75, 1.0) * 0.6, vec3(0.9, 0.95, 1.0), step(abs(bq.y), 5.0)) * (0.6 + 0.4 * step(bq.x, -4.0)); wa = 1.0; }
        if (cap < 0.0) { wcol = vec3(0.1, 0.3, 0.8); wa = 1.0; }
    } else if (wpn < 2.5) {
        // hand fan, snapping open on the beat
        vec2 fq = w - vec2(4.0, 34.0);
        float ang = atan(fq.x, fq.y);
        float open = 0.4 + 0.9 * uBeat;
        if (length(fq) < 46.0 && abs(ang) < open) { wcol = mix(glowpal(0.6), vec3(0.05), step(0.5, fract(ang * 6.0))) * 0.9; wa = 1.0; }
    } else if (wpn < 3.5) {
        // lighter with a flame
        vec2 lq = w - vec2(2.0, 38.0);
        if (max(abs(lq.x) - 6.0, abs(lq.y) - 12.0) < 0.0) { wcol = vec3(0.8, 0.15, 0.2); wa = 1.0; }
        vec2 fl = lq - vec2(0.0, 22.0 + sin(uRealTime * 30.0));
        float flame = length(fl * vec2(1.0, 0.55)) - 6.0;
        if (flame < 0.0) { wcol = mix(vec3(1.0, 0.95, 0.6), vec3(1.0, 0.45, 0.1), smoothstep(-6.0, 0.0, flame)) * 1.8; wa = 1.0; }
    } else {
        // phone at 2%
        vec2 pq = w - vec2(0.0, 50.0);
        if (max(abs(pq.x) - 13.0, abs(pq.y) - 24.0) < 0.0) {
            wcol = vec3(0.05);
            if (max(abs(pq.x) - 11.0, abs(pq.y) - 20.0) < 0.0) {
                wcol = vec3(0.1, 0.12, 0.2) + vec3(1.0, 0.15, 0.1) * drawNum(2.0, 1, pq + vec2(6.0, 3.0), 0.5) + vec3(1.0, 0.15, 0.1) * drawText(T_HUD, 3, pq + vec2(-1.0, 3.0), 0.5);
            }
            wa = 1.0;
        }
    }
    col = mix(col, wcol, wa);
    // the name of the new weapon, just after a swap
    if (swapPh < 4.0) {
        float n = float(textLen(T_WEAPON, int(wpn))) * 6.0;
        float on = drawText(T_WEAPON, int(wpn), floor(vp - vec2(vsize.x * 0.5 - n * 0.5, vsize.y * 0.3)) + 0.5, 0.5);
        col = mix(col, vec3(1.0, 0.9, 0.4), on);
    }

    // ---- status bar
    if (vp.y < 26.0) {
        vec2 sb = vp;
        float n1 = hash12(floor(sb * 0.5));
        col = vec3(0.2, 0.19, 0.18) * (0.8 + 0.3 * n1);
        col *= 1.0 - 0.6 * step(23.0, sb.y) - 0.3 * step(sb.y, 1.0);
        float hydr = 100.0 - mod(floor(uTime * 0.7), 100.0);
        float brain = max(0.0, 3.0 - uMusic.w);
        vec3 red = vec3(0.95, 0.2, 0.12);
        float ink = 0.0;
        vec2 o1 = vec2(6.0, 14.0);
        ink += drawText(T_HUD, 0, floor(sb - o1) + 0.5, 0.5) * 0.7;
        float big = drawNum(hydr, 3, floor((sb - vec2(6.0, 3.0)) / 1.0) + 0.5, 0.5) + drawText(T_HUD, 3, floor(sb - vec2(24.0, 3.0)) + 0.5, 0.5);
        vec2 o2 = vec2(vsize.x - 70.0, 14.0);
        ink += drawText(T_HUD, 1, floor(sb - o2) + 0.5, 0.5) * 0.7;
        big += drawNum(brain, 1, floor(sb - vec2(vsize.x - 70.0, 3.0)) + 0.5, 0.5);
        vec2 o3 = vec2(vsize.x * 0.5 + 22.0, 14.0);
        ink += drawText(T_HUD, 2, floor(sb - o3) + 0.5, 0.5) * 0.7;
        big += drawNum(mod(floor(uBeatCount), 1000.0), 3, floor(sb - vec2(vsize.x * 0.5 + 22.0, 3.0)) + 0.5, 0.5);
        col = mix(col, vec3(0.9, 0.85, 0.7), clamp(ink, 0.0, 1.0));
        col = mix(col, red, clamp(big, 0.0, 1.0));
        // the face: a yellow smiley in sunglasses, gurning with the bass
        vec2 fq = sb - vec2(vsize.x * 0.5, 12.5);
        float face = length(fq) - 11.0;
        if (face < 0.0) {
            col = vec3(1.0, 0.8, 0.15) * (0.85 + 0.15 * step(fq.y, 4.0));
            float glasses = max(abs(abs(fq.x) - 4.5) - 3.5, abs(fq.y - 3.0) - 2.0);
            if (glasses < 0.0 || (abs(fq.y - 3.5) < 0.6 && abs(fq.x) < 8.0)) col = vec3(0.04);
            float jaw = 3.0 + uBass * 4.0 + uBeat * 2.0;          // the gurn
            float mouth = length(vec2(fq.x / (4.0 + jaw * 0.6), (fq.y + 4.0) / 2.0)) - 1.0;
            if (mouth < 0.0 && fq.y < -2.5) col = vec3(0.35, 0.05, 0.05);
            if (mouth < 0.0 && fq.y < -2.5 && fq.y > -4.0) col = vec3(0.95);   // teeth
        }
        if (abs(face) < 0.8) col = vec3(0.05);
    }
    return col;
}
