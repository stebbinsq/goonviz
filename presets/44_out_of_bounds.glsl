vec3 worldNormal(vec3 p) {
    vec2 h = vec2(0.002, -0.002);
    return normalize(h.xyy * world(p + h.xyy) + h.yyx * world(p + h.yyx) + h.yxy * world(p + h.yxy) + h.xxx * world(p + h.xxx));
}

// the skybox, seams and all
vec3 skybox(vec3 rd) {
    vec3 a = abs(rd);
    float face = a.x > a.y && a.x > a.z ? 0.0 : a.y > a.z ? 1.0 : 2.0;
    vec2 fuv = face == 0.0 ? rd.yz / a.x : face == 1.0 ? rd.xz / a.y : rd.xy / a.z;
    vec3 c = mix(vec3(0.55, 0.75, 1.0), vec3(0.2, 0.45, 0.95), smoothstep(-0.1, 0.8, rd.y));
    // low-res clouds, nearest-neighbour filtered
