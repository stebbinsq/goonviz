    float seam = smoothstep(0.985, 1.0, max(abs(fuv.x), abs(fuv.y)));
    c = mix(c, vec3(1.0, 0.0, 1.0), seam * 0.8);
    // below the horizon there's nothing at all
    c = mix(c, vec3(0.02, 0.015, 0.03), smoothstep(0.02, -0.08, rd.y));
    return c;
}

