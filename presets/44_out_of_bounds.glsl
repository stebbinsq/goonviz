    ink += drawText(T_DEBUG, 8, fo - vec2(48.0, 0.0), 1.0 / sc);
    ink += drawNum(1.0, 1, fo - vec2(114.0, 0.0), 1.0 / sc);
    vec2 pr = fc - vec2(3.0 * sc, uRes.y - 37.0 * sc);
    float panel = step(0.0, pr.x) * step(pr.x, 196.0 * sc) * step(0.0, pr.y) * step(pr.y, 34.0 * sc);
    col = mix(col, vec3(0.0, 0.0, 0.05), panel * 0.6);
    col = mix(col, vec3(1.0, 1.0, 0.6), clamp(ink, 0.0, 1.0));
    // OUT OF BOUNDS, blinking
    float s2 = sc * 2.0;
    float nb = float(textLen(T_DEBUG, 1)) * 6.0;
    float oob = drawText(T_DEBUG, 1, (fc - vec2(uRes.x * 0.5 - nb * s2 * 0.5, uRes.y * 0.8)) / s2, 1.0 / s2) * step(0.4, fract(uRealTime * 1.2));
    col = mix(col, vec3(1.0, 0.15, 0.1), oob);
    // a drop: an assertion fails
    float na = float(textLen(T_DEBUG, 7)) * 6.0;
    vec2 ao = vec2(uRes.x * 0.5 - na * sc * 0.5, uRes.y * 0.45);
    float box = step(abs(fc.y - ao.y - 3.5 * sc), 9.0 * sc) * step(abs(fc.x - uRes.x * 0.5), na * sc * 0.5 + 8.0 * sc);
    float af = smoothstep(0.4, 0.7, drop);
    col = mix(col, vec3(0.0, 0.0, 0.6), box * af * 0.9);
    col = mix(col, vec3(1.0), drawText(T_DEBUG, 7, (fc - ao) / sc, 1.0 / sc) * af);
    return col;
}
