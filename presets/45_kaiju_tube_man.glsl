float glyphBit(int g, ivec2 c) {
    if (c.x < 0 || c.x > 4 || c.y < 0 || c.y > 6) return 0.0;
    int row = 6 - c.y;
    ivec2 f = FONT[g];
    int bits = row < 4 ? (f.x >> (row * 5)) : (f.y >> ((row - 4) * 5));
    return float((bits >> (4 - c.x)) & 1);
}
// 4-tap rotated-grid coverage of the glyph pixels; text smaller than about a screen pixel per font pixel
// fades to its average grey instead of shimmering
float drawText(int grp, int s, vec2 q, float fw) {
    int n = textLen(grp, s);
    if (q.x < -1.0 || q.y < -1.0 || q.y > 8.0 || q.x > float(n) * 6.0) return 0.0;
    float cov = 0.0;
    for (int k = 0; k < 4; k++) {
        vec2 o = (k == 0 ? vec2(0.125, 0.375) : k == 1 ? vec2(0.375, -0.125) : k == 2 ? vec2(-0.125, -0.375) : vec2(-0.375, 0.125)) * min(fw, 1.5);
        vec2 qq = q + o;
        int i = int(floor(qq.x / 6.0));
        if (i < 0 || i >= n) continue;
        cov += glyphBit(textChar(grp, s, i), ivec2(floor(qq.x - float(i) * 6.0), floor(qq.y)));
    }
    float box = step(0.0, q.x) * step(q.x, float(n) * 6.0 - 1.0) * step(0.0, q.y) * step(q.y, 7.0);
    return mix(cov * 0.25, box * 0.3, smoothstep(1.0, 2.5, fw));
}
float drawNum(float v, int digits, vec2 q, float fw) {
    if (q.x < -1.0 || q.y < -1.0 || q.y > 8.0 || q.x > float(digits) * 6.0) return 0.0;
    float cov = 0.0;
    for (int k = 0; k < 4; k++) {
        vec2 o = (k == 0 ? vec2(0.125, 0.375) : k == 1 ? vec2(0.375, -0.125) : k == 2 ? vec2(-0.125, -0.375) : vec2(-0.375, 0.125)) * min(fw, 1.5);
        vec2 qq = q + o;
        int i = int(floor(qq.x / 6.0));
        if (i < 0 || i >= digits) continue;
        int d = int(mod(floor(max(v, 0.0) / pow(10.0, float(digits - 1 - i))), 10.0));
        cov += glyphBit(d, ivec2(floor(qq.x - float(i) * 6.0), floor(qq.y)));
    }
    float box = step(0.0, q.x) * step(q.x, float(digits) * 6.0 - 1.0) * step(0.0, q.y) * step(q.y, 7.0);
    return mix(cov * 0.25, box * 0.3, smoothstep(1.0, 2.5, fw));
}
// </text>
float sdBox(vec3 p, vec3 b) { vec3 q = abs(p) - b; return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0); }
float sdCap(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}
vec3 rotAxis(vec3 v, vec3 k, float a) { return v * cos(a) + cross(k, v) * sin(a) + k * dot(k, v) * (1.0 - cos(a)); }

const int NB = 12;           // body segments
const int NA = 6;            // segments per arm
const float SEG = 2.5, RB = 1.25, RA = 0.45, BASE = 2.0;
vec3 gJ[13];                 // body joints
vec3 gArm[14];               // both arms' joints (7 each)
vec3 gFront, gHeadUp;        // the face's frame
float gMat;                  // 0 street, 1 building, 2 tube man, 3 arm, 4 fan box, 5 eye
vec2 gCell;
float gBound;                // distance to the city cell's edge: limits the march step, never a surface

float sdCap2(vec3 p, vec3 a, vec3 b, float ra, float rb) {
    vec3 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - mix(ra, rb, h);
}
float gRJ[13];               // the tube's radius at each joint (puffs of air travel up it)

// The dance. Everything is locked to the beat: the time since the last kick comes from uBeat (it decays as
// exp(-7t)), and the beat count plus that gives a phase that ticks over on every beat.
void pose(vec3 view) {
    float tb = -log(max(uBeat, 0.001)) / 7.0;
    float phase = uBeatCount + min(tb / 0.47, 1.0);
    float groove = 0.35 + 0.65 * clamp(uLevel * 1.6, 0.0, 1.0);    // he dances harder when it's louder
    float wild = 0.03 + 0.1 * uA;
    float fold = 0.0;
    if (mod(floor(uBeatCount), 16.0) < 0.5) fold = uBeat;    // every 16 beats he folds in half
    fold = max(fold, uMusic.y);                                // and on a drop
    // lean about the view axis (reads as left/right on screen); nod about the axis across it
    vec3 vh = normalize(vec3(view.x, 0.0, view.z) + vec3(1e-4, 0.0, 0.0));
    vec3 nodAxis = normalize(cross(vh, vec3(0.0, 1.0, 0.0)));
    // each kick sends a puff of air up the tube: a bulge travelling from the fan to his head
    float puffPos = tb * 15.0 - 1.0;
    float puffAmp = (0.25 + 0.35 * uA) * exp(-tb * 1.5) * step(0.004, uBeat);
    float len = SEG * (0.95 + 0.1 * clamp(uBass * 1.3, 0.0, 1.0));   // the bass inflates him taller
    gJ[0] = vec3(0.0, BASE, 0.0);
    gRJ[0] = RB;
    vec3 dir = vec3(0.0, 1.0, 0.0);
    vec3 shoulder = gJ[0], sdir = dir;
    for (int i = 0; i < NB; i++) {
        float fi = float(i);
        // snap over to the other side on every beat, the lean whipping up the body a moment late
        float ph = phase - fi * 0.035;
        float sd = mod(floor(ph), 2.0) < 0.5 ? 1.0 : -1.0;
        float lean = sd * (2.0 * smoothstep(0.0, 0.3, fract(ph)) - 1.0);
        dir = normalize(rotAxis(dir, vh, lean * (0.05 + 0.09 * fi / 11.0) * (0.6 + uA) * groove));
        // the organic flailing on top of that
        vec3 axis = normalize(vec3(cos(uTime * 0.23 + fi * 0.3), 0.0, sin(uTime * 0.23 + fi * 0.3)));
        float f = wild * sin(uTime * 1.6 - fi * 0.45) + wild * 0.5 * sin(uTime * 3.7 - fi * 0.6 + 1.0);
        if (i == 6) f += fold * 2.5;                             // the fold, at the waist
        dir = normalize(rotAxis(dir, axis, f));
        // head-banging: the top nods toward us on every kick
        if (i >= 9) dir = normalize(rotAxis(dir, nodAxis, -uBeat * 0.22 * groove));
        gJ[i + 1] = gJ[i] + dir * len;
        gRJ[i + 1] = RB * (1.0 + puffAmp * exp(-pow(fi + 1.0 - puffPos, 2.0) / 1.6)) * (i == NB - 1 ? 0.95 : 1.0);
        if (i == 8) { shoulder = gJ[i + 1]; sdir = dir; }
    }
    // arms: thrown up on every kick, waving in time, wiggling with the hi-hats
    vec3 side = normalize(cross(sdir, vh) + vec3(0.0, 0.001, 0.0));
    for (int s = 0; s < 2; s++) {
        float sg = s == 0 ? 1.0 : -1.0;
        vec3 d = normalize(side * sg + sdir * (0.15 + 1.6 * uBeat * groove + 0.4 * uMid));
        int o = s * 7;
        gArm[o] = shoulder;
        for (int i = 0; i < NA; i++) {
            float fi = float(i);
            vec3 axis = normalize(cross(d, vh) + vec3(0.001));
            float a = (0.25 + 0.35 * uA) * sin(TAU * phase + fi * 0.9 + sg * 1.5) * (0.6 + 0.6 * groove)
                    + 0.15 * uHigh * sin(uRealTime * 23.0 + fi * 2.0 + sg);
            d = normalize(rotAxis(d, axis, a));
            gArm[o + i + 1] = gArm[o + i] + d * 1.25;
        }
    }
}

float tubeMan(vec3 p) {
    float d = 1e3;
    gMat = 2.0;
    for (int i = 0; i < NB; i++) d = min(d, sdCap2(p, gJ[i], gJ[i + 1], gRJ[i], gRJ[i + 1]));
    float arms = 1e3;
    for (int i = 0; i < 13; i++) {
        if (i == 6) continue;                                    // the gap between the two arms
        arms = min(arms, sdCap(p, gArm[i], gArm[i + 1], RA));
    }
    if (arms < d) { d = arms; gMat = 3.0; }
    // the eyes, on the side of the head facing the camera
    vec3 hc = mix(gJ[NB - 1], gJ[NB], 0.55);
    vec3 sideV = normalize(cross(gHeadUp, gFront));
    for (int s = 0; s < 2; s++) {
        vec3 ec = hc + gFront * (RB * 0.88) + sideV * (s == 0 ? 0.38 : -0.38) + gHeadUp * 0.25;
        float e = length(p - ec) - 0.24 * (1.0 + 0.3 * uBeat);
        if (e < d) { d = e; gMat = 5.0; }
    }
    // the fan box he's tethered to
    float fan = sdBox(p - vec3(0.0, 1.0, 0.0), vec3(1.6, 1.0, 1.6));
    if (fan < d) { d = fan; gMat = 4.0; }
    return d;
}

// downtown: a block per cell, towers bouncing on the beat; an open plaza around the tube man
const float BP = 5.0;
float city(vec3 p) {
    vec2 id = floor(p.xz / BP);
    vec2 l = p.xz - (id + 0.5) * BP;
    gBound = BP * 0.5 - max(abs(l.x), abs(l.y)) + 0.05;
    gCell = id;
    float d = p.y;
    gMat = 0.0;
    if (max(abs(id.x + 0.5), abs(id.y + 0.5)) < 2.0) return d;    // the plaza
    float h = hash12(id);
    float ht = 1.5 + pow(h, 3.0) * 8.5 + 1.5 * h;
    ht *= 1.0 + uBeat * 0.12 * hash12(id + 3.0);
    vec2 hs = vec2(1.6 + 0.5 * hash12(id + 1.0), 1.6 + 0.5 * hash12(id + 2.0));
    float b = sdBox(vec3(l.x, p.y - ht * 0.5, l.y), vec3(hs.x, ht * 0.5, hs.y));
    if (h > 0.7) b = min(b, sdBox(vec3(l.x, p.y - ht - 1.5, l.y), vec3(hs * 0.6, 1.5)));   // a setback tier
    if (b < d) { d = b; gMat = 1.0; }
    return d;
}

float world(vec3 p) {
    float c = city(p);
    float mc = gMat;
    float t = 1e3;
    if (length(p.xz) < 22.0 && p.y < 34.0) t = tubeMan(p);
    if (t < c) return t;
    gMat = mc;
    return c;
}

vec3 worldNormal(vec3 p) {
    vec2 h = vec2(0.003, -0.003);
    return normalize(h.xyy * world(p + h.xyy) + h.yyx * world(p + h.yyx) + h.yxy * world(p + h.yxy) + h.xxx * world(p + h.xxx));
}

// the news helicopters: positions and where their searchlights point
vec3 heli(int i) {
    float a = uTime * 0.17 + float(i) * 2.094;
    return vec3(cos(a) * 34.0, 24.0 + 3.0 * sin(uTime * 0.3 + float(i)), sin(a) * 34.0);
}
vec3 beamTarget(int i) { return gJ[7 + i] + vec3(sin(uTime * 0.7 + float(i)), 0.0, cos(uTime * 0.6 + float(i))) * 1.5; }

vec3 scene(vec2 p, vec2 uv) {
    // camera: a news helicopter of our own, orbiting, a little shaky (and jolted by the kicks)
    float ang = (uB - 0.5) * 4.0 + uTime * 0.05;
    float dist = mix(62.0, 30.0, uC);
    vec3 ta = vec3(0.0, 15.0, 0.0) + vec3(sin(uRealTime * 1.3), sin(uRealTime * 1.7), 0.0) * 0.15;
    ta += vec3(sin(uRealTime * 41.0), cos(uRealTime * 37.0), 0.0) * uBeat * 0.35;
    vec3 ro = vec3(sin(ang) * dist, 21.0 + 5.0 * sin(uTime * 0.07), cos(ang) * dist);
    vec3 fw = normalize(ta - ro);
    pose(fw);
    vec3 rt = normalize(cross(fw, vec3(0.0, 1.0, 0.0))), up = cross(rt, fw);
    vec3 rd = normalize(p.x * rt + p.y * up + 1.6 * fw);
    // the face looks at the camera
    gHeadUp = normalize(gJ[NB] - gJ[NB - 1]);
    vec3 toCam = normalize(ro - mix(gJ[NB - 1], gJ[NB], 0.55));
    gFront = normalize(toCam - gHeadUp * dot(toCam, gHeadUp));

    float t = 0.1;
    bool hit = false;
    for (int i = 0; i < 160; i++) {
        float d = world(ro + rd * t);
        if (d < 0.002 * t) { hit = true; break; }
        t += min(d, max(gBound, 0.05));
        if (t > 220.0) break;
        if (rd.y > 0.0 && ro.y + rd.y * t > 36.0) break;
    }
    // night sky over the city: an orange glow low down, a few stars
    vec3 sky = mix(vec3(0.16, 0.08, 0.06), vec3(0.01, 0.012, 0.03), smoothstep(-0.05, 0.35, rd.y));
    vec2 st = floor(vec2(atan(rd.z, rd.x), asin(clamp(rd.y, -1.0, 1.0))) * 150.0);
    sky += vec3(0.7) * step(0.998, hash12(st)) * smoothstep(0.1, 0.3, rd.y);
    vec3 col = sky;
    if (hit) {
        vec3 pos = ro + rd * t;
        world(pos);
        float mat = gMat;
        vec2 cell = gCell;
        vec3 n = worldNormal(pos);
        // light: the city's orange glow from below, a cold moon, the searchlights
        vec3 lit = vec3(0.25, 0.12, 0.06) * (0.5 - 0.5 * n.y) + vec3(0.06, 0.07, 0.12) * (0.5 + 0.5 * n.y);
        for (int i = 0; i < 3; i++) {
            vec3 hp = heli(i);
            vec3 bd = normalize(beamTarget(i) - hp);
            vec3 tp = pos - hp;
            float cs = dot(normalize(tp), bd);
            float spot = smoothstep(0.985, 0.995, cs);
            lit += mix(vec3(0.9, 0.95, 1.0), glowpal(float(i) * 0.33 + uTime * 0.05) * 1.3, uBeat * 0.8) * spot * max(dot(n, -normalize(tp)), 0.0) * 1.6;
        }
        if (mat == 2.0 || mat == 3.0) {
            // the nylon: a bright colour, wrinkled, with a satin sheen; it glows a little inside on the beat
            // D = 0: the classic red tube man with yellow arms; turning it up brings in the palette
            vec3 classic = mat == 2.0 ? vec3(1.0, 0.1, 0.05) : vec3(1.0, 0.78, 0.08);
            vec3 base = mix(classic, glowpal(uD + (mat == 2.0 ? 0.05 : 0.45)) * 1.2, smoothstep(0.0, 0.6, uD));
            float wr = 0.85 + 0.15 * sin(dot(pos, gHeadUp) * 6.0 + noise(pos.xz * 2.0) * 3.0);
            float fres = pow(1.0 - max(dot(n, -rd), 0.0), 3.0);
            col = base * (lit * 1.6 + 0.15) * wr + base * fres * 0.6 + base * uBeat * 0.5;
            // the face: a huge grin under the eyes
            vec3 hc = mix(gJ[NB - 1], gJ[NB], 0.55);
            vec3 sideV = normalize(cross(gHeadUp, gFront));
            vec3 lp = pos - hc;
            float fx = dot(lp, sideV), fy = dot(lp, gHeadUp), fz = dot(lp, gFront);
            if (mat == 2.0 && fz > 0.4) {
                // the mouth: a grin that opens wide on the bass, like he's singing along
                float open = 0.06 + 0.42 * clamp(uBass * 1.3 + uBeat * 0.3, 0.0, 1.0);
                float my = fy + 0.3 - 0.35 * fx * fx;                // the corners curl up
                float mouth = length(vec2(fx / 0.62, my / open)) - 1.0;
                if (mouth < 0.0) col = mix(vec3(0.3, 0.02, 0.03), vec3(0.02), smoothstep(-0.2, -0.7, mouth));
                // the frill on top of his head
                float top = dot(pos - gJ[NB], gHeadUp);
                col = mix(col, base * 1.4, smoothstep(-0.3, 0.0, top) * step(0.5, fract(atan(fx, fz) * 3.0)));
            }
        } else if (mat == 5.0) {
            col = vec3(0.02) + vec3(1.0) * pow(max(dot(reflect(rd, n), normalize(vec3(0.3, 0.8, 0.5))), 0.0), 30.0);
        } else if (mat == 4.0) {
            col = vec3(0.12, 0.12, 0.14) * (lit + 0.2);
        } else if (mat == 1.0) {
            // towers: dark glass with lit windows
            vec2 id = floor(pos.xz / BP);
            float u = abs(n.x) > 0.5 ? pos.z : pos.x;
            vec2 w = vec2(u * 4.0, pos.y * 3.0);
            vec2 wi = floor(w), wf = fract(w);
            float win = step(0.25, wf.x) * step(0.3, wf.y) * step(abs(n.y), 0.5);
            float on = step(hash12(wi + id * 17.0), 0.28);
            vec3 wc = mix(vec3(1.0, 0.75, 0.45), vec3(0.6, 0.8, 1.0), step(0.8, hash12(wi + 3.0)));
            if (hash12(id + 9.0) > 0.72) {
                // some towers dance too: their windows fill up to the bass like a level meter
                float level = (0.2 + 0.8 * clamp(uBass * 1.4 * (0.6 + 0.8 * hash12(id + floor(uBeatCount))), 0.0, 1.0)) * 36.0;
                on = step(wi.y, level);
                wc = glowpal(hash12(id) + wi.y * 0.02 + uTime * 0.03) * 1.8;
            }
            col = vec3(0.03, 0.035, 0.05) * (lit * 2.0 + 0.3) + wc * win * on * 0.45;
            col += vec3(0.5, 0.6, 0.8) * pow(max(dot(reflect(rd, n), normalize(vec3(0.0, 0.2, 1.0) - pos * 0.0)), 0.0), 8.0) * 0.05;
            if (n.y > 0.5) col = vec3(0.05) * (lit + 0.3) + vec3(1.0, 0.1, 0.05) * step(0.5, fract(uRealTime * 0.8 + hash12(id))) * smoothstep(0.04, 0.0, length(fract(pos.xz / BP) - 0.5)) * 3.0;
        } else {
            // streets: dark, with streaks of traffic and the plaza's paving
            vec2 l = pos.xz - (floor(pos.xz / BP) + 0.5) * BP;
            float street = smoothstep(2.0, 2.2, max(abs(l.x), abs(l.y)));
            col = vec3(0.04, 0.035, 0.035) * (lit + 0.4);
            float along = abs(l.x) > abs(l.y) ? pos.z : pos.x;
            float cars = step(0.75, fract(along * 0.4 + uTime * 0.8 * (abs(l.x) > abs(l.y) ? 1.0 : -1.0) + hash12(floor(pos.xz / BP)))) * street;
            col += mix(vec3(1.0, 0.1, 0.05), vec3(1.0, 0.95, 0.8), step(0.0, l.x + l.y)) * cars * 0.8;
            col += vec3(0.25, 0.15, 0.08) * smoothstep(20.0, 0.0, length(pos.xz)) * 0.3;     // the plaza, lit by the show
        }
        col = mix(col, vec3(0.12, 0.07, 0.06), 1.0 - exp(-t * 0.007));
    }
    // searchlight beams in the haze, and the helicopters' blinking lights
    for (int i = 0; i < 3; i++) {
        vec3 a = heli(i);
        vec3 dir = normalize(beamTarget(i) - a);
        vec3 w0 = ro - a;
        float bb = dot(rd, dir), dd = dot(rd, w0), ee = dot(dir, w0);
        float den = max(1.0 - bb * bb, 1e-4);
        float sc = (bb * ee - dd) / den;
        float tc = max((ee - bb * dd) / den, 0.0);
        float dist = length(w0 + rd * sc - dir * tc);
        float wid = 0.2 + tc * 0.09;
        vec3 bc = mix(vec3(0.6, 0.65, 0.75), glowpal(float(i) * 0.33 + uTime * 0.05), uBeat * 0.8);
        col += bc * exp(-dist * dist / (wid * wid)) * smoothstep(0.0, 6.0, sc) * smoothstep(t + 2.0, t - 2.0, sc) * (0.09 + 0.05 * uBeat);
        vec3 v = a - ro;
        float dl = length(v - rd * dot(v, rd));
        col += vec3(0.3) * smoothstep(0.6, 0.2, dl) * step(dot(v, rd), t);
        col += vec3(1.0, 0.1, 0.05) * smoothstep(0.35, 0.0, dl) * step(0.5, fract(uRealTime * 1.5 + float(i) * 0.3)) * 3.0;
    }

    // ---- the news channel
    vec2 fc = uv * uRes;
    float s = max(1.0, floor(uRes.y / 270.0));
    // lower third: BREAKING NEWS, the headline, and the ticker
    float barH = 30.0 * s;
    if (fc.y < barH) {
        col = mix(vec3(0.02, 0.02, 0.06), vec3(0.06, 0.06, 0.14), fc.y / barH);
        // ticker
        float tw = float(textLen(T_TICKER, 0)) * 6.0;
        float x0 = uRes.x - mod(uTime * 38.0, tw + uRes.x / s) * s;
        float tk = drawText(T_TICKER, 0, (fc - vec2(x0, 3.0 * s)) / s, 1.0 / s);
        col = mix(col, vec3(1.0, 0.95, 0.8), tk);
        // headline band
        if (fc.y > 13.0 * s) {
            col = vec3(0.9, 0.9, 0.92);
            vec2 hq = (fc - vec2(90.0 * s, 16.0 * s)) / s;
            col = mix(col, vec3(0.05), drawText(T_NEWS, 4, hq, 1.0 / s));
            // BREAKING NEWS tag
            if (fc.x < 86.0 * s) {
                col = vec3(0.8, 0.05, 0.05);
                col = mix(col, vec3(1.0), drawText(T_NEWS, 1, (fc - vec2(3.0 * s, 16.0 * s)) / s, 1.0 / s));
            }
        }
    }
    // the channel's bug, top right, and a blinking LIVE tag, top left
    {
        vec2 lq = fc - vec2(8.0 * s, uRes.y - 18.0 * s);
        if (lq.x > -3.0 * s && lq.x < 30.0 * s && lq.y > -3.0 * s && lq.y < 10.0 * s) {
            col = mix(col, vec3(0.85, 0.05, 0.05), 0.9);
            col = mix(col, vec3(1.0), drawText(T_NEWS, 0, (lq - vec2(4.0 * s, 0.0)) / s, 1.0 / s));
        }
        float dot_ = smoothstep(3.0 * s, 2.0 * s, length(lq - vec2(36.0 * s, 3.5 * s))) * step(0.5, fract(uRealTime));
        col = mix(col, vec3(1.0, 0.1, 0.1), dot_);
        vec2 bq = fc - vec2(uRes.x - 56.0 * s, uRes.y - 18.0 * s);
        col = mix(col, vec3(1.0), 0.85 * drawText(T_NEWS, 2, bq / s, 1.0 / s));
        col = mix(col, vec3(1.0), 0.85 * drawText(T_NEWS, 3, (bq - vec2(12.0 * s, -10.0 * s)) / s, 1.0 / s));
    }
    return col;
}
