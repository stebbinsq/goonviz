float world(vec3 p) {
    vec2 id = floor(p.xz / CELL);
    vec2 lc = p.xz - (id + 0.5) * CELL;
    gBound = CELL * 0.5 - max(abs(lc.x), abs(lc.y)) + 0.05;   // never step past this cell's edge
    float d = 1e3;
    vec4 is = island(id);
    gMat = 0.0; gId = id; gLoc = vec3(lc.x, p.y, lc.y);
    if (is.x > 0.0) {
